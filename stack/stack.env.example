# Example only. bootstrap.py/setup scripts write the real file outside Git.
# Never use 0.0.0.0. For a shared server, use one trusted private/overlay IP and ACL it.
HPS_BIND_ADDRESS=127.0.0.1

# Absolute path to a runtime SearXNG directory whose settings.yml contains a
# unique generated secret key. The installer creates this automatically.
HPS_SEARXNG_CONFIG_DIR=/absolute/path/to/private/runtime/searxng

# Small local model used only by Hindsight background memory work.
HPS_HINDSIGHT_MODEL=qwen3.5:4b

# Optional release/image overrides. Stable releases will eventually pin these.
# HPS_OLLAMA_IMAGE=ollama/ollama:latest
# HPS_CURL_IMAGE=curlimages/curl:latest
# HPS_HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:latest
# HPS_SEARXNG_IMAGE=searxng/searxng:latest
# HPS_DOCLING_IMAGE=quay.io/docling-project/docling-serve:latest
# HPS_ACTIVEPIECES_IMAGE=activepieces/activepieces:latest
# HPS_NANGO_POSTGRES_IMAGE=postgres:16.0-alpine
# HPS_NANGO_IMAGE=nangohq/nango-server:hosted
# HPS_NANGO_PLATFORM=linux/amd64

# Optional Activepieces browser-visible URL. Keep localhost unless you have
# deliberately configured a private/public callback strategy.
# HPS_ACTIVEPIECES_URL=http://localhost:8090

# Nango Free Self-Hosted is configured by scripts/setup_nango.py.
# Real values below are generated into the private runtime stack.env; do not
# place real secrets in this example or commit them.
# HPS_NANGO_ENCRYPTION_KEY=<base64 32-byte key; cannot currently be rotated>
# HPS_NANGO_DB_PASSWORD=<generated>
# HPS_NANGO_DASHBOARD_USERNAME=hps-admin
# HPS_NANGO_DASHBOARD_PASSWORD=<generated>
# HPS_NANGO_SERVER_URL=http://localhost:3003
# HPS_NANGO_CONNECT_URL=http://localhost:3009
